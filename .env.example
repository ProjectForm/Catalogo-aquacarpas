# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no projeto da Vercel.
# A chave "anon" do Supabase é pública por natureza (vai para o navegador): quem protege os dados é o RLS.
# NUNCA coloque aqui a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://vxrfyprtikznvklodqmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço público do catálogo (sitemap e Open Graph). Só vale fora da Vercel: lá o site usa o domínio de
# produção que a própria Vercel informa (hoje https://catalogo-aquacarpas.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
